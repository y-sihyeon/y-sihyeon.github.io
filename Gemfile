# 로컬 미리보기 전용입니다. GitHub Pages 는 이 파일을 쓰지 않고 자체 환경으로 빌드합니다.
# github-pages gem 이 GitHub Pages 서버와 똑같은 Jekyll·플러그인 버전을 고정해 주므로,
# 내 컴퓨터에서 보이는 모습이 실제 사이트와 같습니다.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# Ruby 3 부터 기본 포함에서 빠져서 jekyll serve 에 필요합니다.
gem "webrick"
# remote_theme 을 받아올 때 뜨는 경고를 없앱니다.
gem "faraday-retry"
